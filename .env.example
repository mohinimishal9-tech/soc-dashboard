# Copy this file to ".env" and fill in your values.
# If these are left blank / invalid, the dashboard automatically
# falls back to realistic DEMO DATA so it still runs and can be graded
# without a live AWS account.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Set to "true" to force demo/mock data even if AWS credentials are present
FORCE_DEMO_MODE=false

# Flask
FLASK_PORT=5000
